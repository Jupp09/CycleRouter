{
  "name": "cyclorouter",
  "version": "1.0.0",
  "private": true,
  "description": "Routenplaner für Rennrad, Gravelbike und Fahrrad",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node tests/run.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run typecheck && npm run test:unit",
    "check:live": "node scripts/check-live.mjs",
    "warm": "node server/warm.mjs",
    "extract:update": "node server/extract-update.mjs",
    "feedback": "node server/feedback-list.mjs",
    "mail:test": "node server/mail-test.mjs",
    "extract:build": "node --max-old-space-size=12288 scripts/build-poi-extract.mjs"
  },
  "dependencies": {
    "mariadb": "3.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
