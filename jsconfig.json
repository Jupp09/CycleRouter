{
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "allowJs": true,
    "noEmit": true,
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["js/**/*.js", "server/**/*.mjs", "server.mjs", "scripts/**/*.mjs", "tests/unit/**/*.mjs", "types/**/*.d.ts"]
}
