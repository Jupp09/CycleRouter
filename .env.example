# Vorlage für die Server-Konfiguration – als .env kopieren und anpassen.
# Echte Zugangsdaten gehören NUR in .env (wird von Git ignoriert), niemals in diese Datei.
# Ohne DB_HOST läuft CycloRouter ohne Konten und gespeicherte Routen.

# PORT=8000

# MariaDB (≥ 10.5) oder MySQL (≥ 8.0.16) für Konten, Einstellungen und gespeicherte Routen
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cyclerouter
DB_PASSWORD=bitte-aendern
DB_NAME=cyclerouter

# Verschlüsselte Verbindung – empfohlen, wenn die Datenbank auf einem anderen Rechner läuft:
#   true = mit Zertifikatsprüfung, skip-verify = verschlüsselt ohne Prüfung (selbst signierte Zertifikate)
# DB_SSL=true

# Nur MySQL 8 ohne DB_SSL: erlaubt die Anmeldung per caching_sha2_password. Bei DB_HOST=localhost/127.0.0.1
# automatisch an; bei entfernten Datenbanken nur setzen, wenn das Netz dazwischen vertrauenswürdig ist.
# DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# Gültigkeit des Verpflegungsstellen-Caches in Tagen
# POI_TTL_DAYS=30

# Datenauszug Europa (wöchentlich per GitHub Actions gebaut, ~100 MB Download, entpackt einige 100 MB in
# cache/extract/). Standard: Release „poi-data“ dieses Repos. „off“ schaltet ihn ab (dann nur Overpass).
# POI_EXTRACT_URL=https://github.com/Jupp09/CycleRouter/releases/download/poi-data/pois-europe.json
