# Vorlage für die Server-Konfiguration – als .env kopieren und anpassen.
# Echte Zugangsdaten gehören NUR in .env (wird von Git ignoriert), niemals in diese Datei.
# Ohne DB_HOST läuft CycloRouter ohne Konten und gespeicherte Routen.

# PORT=8000

# MariaDB (≥ 10.5) oder MySQL (≥ 8.0.16) für Konten, Einstellungen und gespeicherte Routen
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cyclerouter
DB_PASSWORD=bitte-aendern
DB_NAME=cyclerouter

# Konten mit Verwaltungsrechten (Feedback lesen, beantworten, löschen; Serverstatus): Benutzernamen,
# durch Kommas getrennt. In der App unter Einstellungen → Verwaltung („Feedback verwalten“, „Serverstatus“). Leer = niemand.
# ADMIN_USERS=meinname

# Impressum und Datenschutzerklärung (impressum.html, datenschutz.html): Der Server setzt diese Angaben beim
# Ausliefern ein – so steht deine Anschrift nicht im öffentlichen Repo. In IMPRESSUM_ADDRESS trennt „|“ die Zeilen.
# Fehlt eine Angabe, zeigt die Seite einen markierten Hinweis (npm run check:live meldet das). Telefon ist freiwillig.
# HOSTER_LOG_DAYS: nach wie vielen Tagen das Hosting die Webserver-Protokolle löscht (Plesk: Protokollrotation).
# IMPRESSUM_NAME=Max Mustermann
# IMPRESSUM_ADDRESS=Musterstraße 1|12345 Musterstadt
# IMPRESSUM_EMAIL=kontakt@example.org
# IMPRESSUM_PHONE=
# HOSTER_LOG_DAYS=7

# E-Mail bei neuer Rückmeldung (nur Nummer und Art, kein Inhalt) an FEEDBACK_NOTIFY (Kommas trennen mehrere).
# Port 465 = TLS, 587 = STARTTLS; ohne Verschlüsselung wird nie gesendet. Prüfen mit: npm run mail:test
# SMTP_HOST=mail.example.org
# SMTP_PORT=587
# SMTP_USER=cyclorouter@example.org
# SMTP_PASS=geheim
# MAIL_FROM=cyclorouter@example.org
# FEEDBACK_NOTIFY=ich@example.org

# Verschlüsselte Verbindung – empfohlen, wenn die Datenbank auf einem anderen Rechner läuft:
#   true = mit Zertifikatsprüfung, skip-verify = verschlüsselt ohne Prüfung (selbst signierte Zertifikate)
# DB_SSL=true

# Nur MySQL 8 ohne DB_SSL: erlaubt die Anmeldung per caching_sha2_password. Bei DB_HOST=localhost/127.0.0.1
# automatisch an; bei entfernten Datenbanken nur setzen, wenn das Netz dazwischen vertrauenswürdig ist.
# DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# Gültigkeit des Verpflegungsstellen-Caches in Tagen
# POI_TTL_DAYS=30

# Datenauszug Europa (wöchentlich per GitHub Actions gebaut, ~100 MB Download, entpackt einige 100 MB in
# cache/extract/). Standard: Release „poi-data“ dieses Repos. „off“ schaltet ihn ab (dann nur Overpass).
# POI_EXTRACT_URL=https://github.com/Jupp09/CycleRouter/releases/download/poi-data/pois-europe.json

# Eigener BRouter-Server (ohne /brouter am Ende). Der Browser fragt über diesen Server an (/api/brouter),
# brouter.de bleibt Ausweich. BROUTER_PARALLEL = Thread-Zahl, mit der BRouter gestartet wurde (Standard 1).
# https empfohlen (BRouter z. B. hinter Caddy mit Let's-Encrypt-Zertifikat), http nur im eigenen Netz.
# BROUTER_URL=https://brouter.example.org
# BROUTER_PARALLEL=1

# Öffentliche Adresse der App. Mit https:// bekommt das Sitzungs-Cookie immer „Secure“ und der Server
# sendet HSTS – im Betrieb hinter einem Proxy (Plesk/Passenger) unbedingt setzen.
# PUBLIC_URL=https://cyclo.example.org

# Nutzer-IP hinter Proxys (Grundlage aller Begrenzungen): Standard ist, X-Forwarded-For nur zu glauben,
# wenn die Verbindung von einem Proxy auf diesem Rechner/im eigenen Netz kommt. „off“ ignoriert die Header.
# TRUST_PROXY=off
# DEBUG_IP=1 schreibt die ersten 20 erkannten IPs samt Headern ins Log – zum Prüfen nach der Einrichtung,
# danach wieder entfernen.
# DEBUG_IP=1
