# Vorlage für die Server-Konfiguration – als .env kopieren und anpassen (.env wird nicht eingecheckt).
# Ohne DB_HOST läuft CycleRouter ohne Konten und gespeicherte Routen.

# PORT=8000

# MariaDB für Konten, Einstellungen und gespeicherte Routen
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cyclerouter
DB_PASSWORD=bitte-aendern
DB_NAME=cyclerouter

# Gültigkeit des Verpflegungsstellen-Caches in Tagen
# POI_TTL_DAYS=30
